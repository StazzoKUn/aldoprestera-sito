{
  "name": "ordini-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend per la gestione degli ordini di un e-commerce (Express + Prisma + MariaDB di XAMPP)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx scripts/check-db.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:menu": "tsx scripts/menu-carica.ts",
    "db:studio": "prisma studio",
    "admin:crea": "tsx scripts/admin-crea.ts",
    "admin:dev": "tsx scripts/admin-dev.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
