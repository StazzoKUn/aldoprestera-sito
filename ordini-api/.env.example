# Copia questo file in .env e adatta i valori.

# Ambiente: development attiva il log delle query SQL di Prisma nel terminale.
NODE_ENV=development
PORT=3000

# Connessione al MariaDB di XAMPP: mysql://UTENTE:PASSWORD@HOST:PORTA/DATABASE
# XAMPP di default: utente root senza password.
DATABASE_URL="mysql://root@localhost:3306/aldop"

# Segreto condiviso col server del sito (stesso valore in aldo-prestera/.env), almeno 16 caratteri.
# Genera il tuo valore casuale: non usare questo.
ORDINI_API_TOKEN=valore-fittizio-cambiami-0123456789

# Facoltative: account di Aldo per /gestione, creato o aggiornato a ogni avvio (utile su Plesk senza SSH).
# Per cambiare la password basta modificare ADMIN_PASSWORD (min 10 caratteri) e riavviare. Lascia vuote in sviluppo.
ADMIN_USERNAME=
ADMIN_NOME=
ADMIN_PASSWORD=

# Facoltativa. Se vuota, `prisma migrate dev` crea uno shadow database temporaneo
# e lo cancella alla fine (richiede il permesso di creare database).
SHADOW_DATABASE_URL=
