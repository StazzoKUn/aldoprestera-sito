# Invio email ordini (SMTP). Senza queste variabili, in sviluppo l'ordine viene solo stampato in console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ordini@aldoprestera.it
SMTP_PASS=
ORDER_FROM="Sito web <ordini@aldoprestera.it>"
ORDER_TO=aldo@example.com
# Backend ordini (cartella ordini-api/): menù e salvataggio ordini su MariaDB. Default: http://127.0.0.1:3000
ORDINI_API_URL=http://127.0.0.1:3000
# Segreto condiviso con ordini-api (stesso valore di ORDINI_API_TOKEN in ordini-api/.env). Valore fittizio: genera il tuo.
ORDINI_API_TOKEN=valore-fittizio-cambiami-0123456789
# Servizio whatsapp-bot (cartella whatsapp-bot/). Se vuoto, la comanda parte solo via email.
WA_BOT_URL=http://127.0.0.1:3100
WA_BOT_TOKEN=cambia-questo-segreto
