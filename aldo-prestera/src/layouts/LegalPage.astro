---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Layout title={`${title} · ${site.name}`}>
  <Header />
  <main class="legal">
    <h1>{title}</h1>
    <slot />
  </main>
  <Footer />
</Layout>

<style>
  .legal {
    max-width: 720px;
    padding: 72px var(--gutter);
    font-size: 16px;
    line-height: 1.7;
    font-weight: 300;
    color: var(--on-dark-muted);
  }
  .legal :global(h2) {
    font-size: 30px;
    line-height: 1.1;
    color: var(--on-dark);
    margin: 36px 0 10px;
  }
  .legal :global(p) {
    margin-bottom: 14px;
  }
  .legal :global(ul) {
    margin: 0 0 14px 20px;
    list-style: disc;
  }
  .legal :global(li) {
    margin-bottom: 8px;
  }
  .legal :global(strong) {
    color: var(--on-dark);
    font-weight: 500;
  }
  .legal :global(a) {
    text-decoration: underline;
  }
  h1 {
    font-size: 56px;
    line-height: 1;
    color: var(--on-dark);
    margin-bottom: 32px;
  }
</style>
